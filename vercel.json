{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npx prisma migrate deploy && npm run build",
  "crons": [
    {
      "path": "/api/cron/loyers",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/indices",
      "schedule": "30 7 * * *"
    },
    {
      "path": "/api/cron/assurances",
      "schedule": "0 8 * * 1"
    }
  ]
}
