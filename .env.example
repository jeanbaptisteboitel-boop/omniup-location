# ---- Base de données PostgreSQL (Neon en production)
# DATABASE_URL : chaîne « pooled » (hôte -pooler) utilisée par l'application
# DIRECT_URL   : chaîne directe utilisée par les migrations (prisma migrate deploy)
DATABASE_URL="postgresql://USER:MOT_DE_PASSE@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:MOT_DE_PASSE@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"
# En local : postgresql://omniup:omniup@localhost:5432/omniup?schema=public (même valeur pour les deux)

# ---- Fichiers importés (pièces d'identité, justificatifs, factures)
# Stockage objet Scaleway (obligatoire sur Vercel). Sans ces variables, les fichiers sont écrits sur le disque local.
SCW_ACCESS_KEY=
SCW_SECRET_KEY=
SCW_BUCKET=
SCW_REGION=fr-par
# SCW_ENDPOINT=https://s3.fr-par.scw.cloud   (déduit de la région si absent)
# Dossier local utilisé quand le stockage objet n'est pas configuré
STORAGE_DIR="./storage"

# ---- Protection de l'application (obligatoire dès qu'elle est accessible sur Internet)
# Mot de passe demandé à l'ouverture ; APP_SECRET (facultatif) signe le cookie de session.
APP_PASSWORD=
APP_SECRET=

# ---- Envoi d'emails (SMTP) — facultatif ; sans configuration, les envois sont désactivés
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Gestion locative <gestion@exemple.fr>"

# ---- Appels de loyer
# Nombre de jours avant le début du mois pour émettre les avis d'échéance
AVIS_JOURS_AVANCE=10
# Envoi automatique par email des avis nouvellement émis lors de l'exécution planifiée (/api/cron/loyers)
AVIS_ENVOI_AUTO=false
# Secret protégeant /api/cron/loyers (Vercel l'envoie automatiquement en en-tête Authorization: Bearer)
CRON_SECRET=

# ---- Assistant de rédaction (Anthropic) — contrats, courriers, emails
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ---- OCR et extraction (Mistral) — lecture des échéanciers PDF/images et des justificatifs
MISTRAL_API_KEY=
MISTRAL_MODEL_OCR=mistral-ocr-latest
MISTRAL_MODEL_EXTRACTION=mistral-medium-latest

# ---- Omniup Sign (signature électronique) — intégration à venir
OMNIUP_SIGN_URL=
OMNIUP_SIGN_API_KEY=
