# Base de données SQLite (chemin relatif au dossier prisma/)
DATABASE_URL="file:./dev.db"

# Dossier de stockage des fichiers importés (pièces d'identité, justificatifs…)
STORAGE_DIR="./storage"

# ---- Envoi d'emails (SMTP) — facultatif ; sans configuration, les envois sont désactivés
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Gestion locative <gestion@exemple.fr>"

# Nombre de jours avant le début du mois pour émettre les avis d'échéance
AVIS_JOURS_AVANCE=10
# Envoi automatique par email des avis nouvellement émis lors de la génération planifiée (/api/cron/loyers)
AVIS_ENVOI_AUTO=false
# Secret protégeant l'URL de génération planifiée : /api/cron/loyers?secret=...
CRON_SECRET=

# ---- Assistant IA (Anthropic) — facultatif
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ---- Omniup Sign (signature électronique) — intégration à venir
OMNIUP_SIGN_URL=
OMNIUP_SIGN_API_KEY=
