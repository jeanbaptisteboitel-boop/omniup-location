// Schéma de données OMNIUP Location (PostgreSQL — Neon en production)
// Montants en euros (Float, arrondis à 2 décimales dans l'application).
// Dates « jour » stockées à minuit UTC.
// DATABASE_URL : connexion « pooled » utilisée par l'application ; DIRECT_URL : connexion directe pour les migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Entités (dossiers) et réglages
// ---------------------------------------------------------------------------

enum TypeEntite {
  PERSONNE
  SOCIETE
  AUTRE
}

/// Entité gérée : une personne ou une société disposant de ses propres bailleurs, lots et locataires.
/// Une seule entité par défaut ; la gestion de plusieurs entités se débloque dans les réglages.
model Entite {
  id         Int              @id @default(autoincrement())
  nom        String
  type       TypeEntite       @default(AUTRE)
  notes      String?
  bailleurs  Bailleur[]
  immeubles  Immeuble[]
  lots       Lot[]
  locataires Locataire[]
  baux       Bail[]
  depenses   Depense[]
  emprunts   Emprunt[]
  documents  DocumentGenere[]
  demandes   DemandeMaintenance[]
  acces      AccesEntite[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
}

// ---------------------------------------------------------------------------
// Utilisateurs de l'application (gestionnaires) et droits par entité
// ---------------------------------------------------------------------------

/// Rôle d'un utilisateur sur une entité : administrateur (gère l'entité et ses utilisateurs),
/// gestionnaire (toutes les opérations courantes) ou lecture seule.
enum RoleEntite {
  ADMINISTRATEUR
  GESTIONNAIRE
  LECTURE
}

/// Compte de connexion (email et mot de passe). Le super-administrateur (cabinet) accède à toutes les entités.
model Utilisateur {
  id                Int           @id @default(autoincrement())
  email             String        @unique
  nom               String
  motDePasse        String?
  superAdmin        Boolean       @default(false)
  actif             Boolean       @default(true)
  jetonInvitation   String?       @unique
  jetonExpireLe     DateTime?
  derniereConnexion DateTime?
  acces             AccesEntite[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

/// Droit d'un utilisateur sur une entité.
model AccesEntite {
  id            Int         @id @default(autoincrement())
  utilisateurId Int
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  entiteId      Int
  entite        Entite      @relation(fields: [entiteId], references: [id], onDelete: Cascade)
  role          RoleEntite  @default(GESTIONNAIRE)
  createdAt     DateTime    @default(now())

  @@unique([utilisateurId, entiteId])
  @@index([entiteId])
}

enum CategorieModele {
  BAIL
  AVENANT
  RENOUVELLEMENT
  RESILIATION
  CAUTION
  CONVENTION
  AUTRE
}

/// Modèle de document (fourni par défaut ou créé par l'utilisateur), partagé par toutes les entités.
/// Le contenu est un texte structuré (« # », « ## », « - ») avec des variables {{bail.loyerHC}}, {{locataire.nomComplet}}…
model ModeleDocument {
  id          Int              @id @default(autoincrement())
  code        String?          @unique
  nom         String
  categorie   CategorieModele
  description String?
  contenu     String
  parDefaut   Boolean          @default(false)
  documents   DocumentGenere[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

/// Document établi à partir d'un modèle (avenant, renouvellement, résiliation, acte de caution…),
/// rattaché à une entité et, le cas échéant, à un bail.
model DocumentGenere {
  id        Int             @id @default(autoincrement())
  entiteId  Int
  entite    Entite          @relation(fields: [entiteId], references: [id], onDelete: Restrict)
  bailId    Int?
  bail      Bail?           @relation(fields: [bailId], references: [id], onDelete: Cascade)
  modeleId  Int?
  modele    ModeleDocument? @relation(fields: [modeleId], references: [id], onDelete: SetNull)
  titre     String
  categorie CategorieModele
  contenu   String
  dateEnvoi DateTime?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([entiteId])
  @@index([bailId])
}

/// Réglages globaux de l'application (une seule ligne, id = 1).
model Reglages {
  id           Int      @id @default(1)
  multiEntites Boolean  @default(false)
  updatedAt    DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Patrimoine
// ---------------------------------------------------------------------------

enum TypePersonne {
  PHYSIQUE
  MORALE
}

/// Propriétaire bailleur : personne physique ou société (SCI, SARL…).
model Bailleur {
  id                Int          @id @default(autoincrement())
  entiteId          Int
  entite            Entite       @relation(fields: [entiteId], references: [id], onDelete: Restrict)
  typePersonne      TypePersonne @default(PHYSIQUE)
  nom               String
  representant      String?
  adresse           String
  complementAdresse String?
  codePostal        String
  ville             String
  email             String?
  telephone         String?
  siren             String?
  /// Numéro de TVA intracommunautaire, imprimé sur les avis d'échéance et quittances soumis à TVA.
  numeroTva         String?
  iban              String?
  bic               String?
  notes             String?
  immeubles         Immeuble[]
  lots              Lot[]
  /// Espace propriétaire : jeton d'accès personnel (lien), création, envoi par email et dernière visite.
  accesJeton        String?      @unique
  accesCreeLe       DateTime?
  accesEnvoyeLe     DateTime?
  accesDernierLe    DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([entiteId])
}

/// Immeuble : regroupement facultatif de lots (copropriété, immeuble entier…).
model Immeuble {
  id                Int       @id @default(autoincrement())
  entiteId          Int
  entite            Entite    @relation(fields: [entiteId], references: [id], onDelete: Restrict)
  nom               String
  adresse           String
  complementAdresse String?
  codePostal        String
  ville             String
  notes             String?
  /// Option pour la TVA sur les loyers des locaux professionnels ou commerciaux (CGI, art. 260 2°), exercée immeuble par immeuble.
  optionTva         Boolean   @default(false)
  optionTvaDate     DateTime?
  bailleurId        Int?
  bailleur          Bailleur? @relation(fields: [bailleurId], references: [id], onDelete: SetNull)
  lots              Lot[]
  depenses          Depense[]
  emprunts          Emprunt[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([entiteId])
}

enum TypeLot {
  APPARTEMENT
  MAISON
  LOCAL_COMMERCIAL
  LOCAL_PROFESSIONNEL
}

/// Lot : le bien loué (appartement ou maison).
model Lot {
  id                 Int       @id @default(autoincrement())
  entiteId           Int
  entite             Entite    @relation(fields: [entiteId], references: [id], onDelete: Restrict)
  type               TypeLot
  nom                String
  adresse            String
  complementAdresse  String?
  codePostal         String
  ville              String
  etage              String?
  surface            Float?
  nbPieces           Int?
  meuble             Boolean   @default(false)
  loyerIndicatif     Float?
  chargesIndicatives Float?
  /// Loyers du lot soumis à la TVA (option exercée pour ce local, effective si l'immeuble a lui-même opté).
  optionTva          Boolean   @default(false)
  optionTvaDate      DateTime?
  description        String?
  bailleurId         Int?
  bailleur           Bailleur? @relation(fields: [bailleurId], references: [id], onDelete: SetNull)
  immeubleId         Int?
  immeuble           Immeuble? @relation(fields: [immeubleId], references: [id], onDelete: SetNull)
  baux               Bail[]
  depenses           Depense[]
  emprunts           Emprunt[]
  demandes           DemandeMaintenance[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([entiteId])
}

// ---------------------------------------------------------------------------
// Locataires et documents
// ---------------------------------------------------------------------------

model Locataire {
  id                Int        @id @default(autoincrement())
  entiteId          Int
  entite            Entite     @relation(fields: [entiteId], references: [id], onDelete: Restrict)
  civilite          String?
  nom               String
  prenom            String
  dateNaissance     DateTime?
  adresse           String?
  complementAdresse String?
  codePostal        String?
  ville             String?
  telephone         String?
  email             String?
  notes             String?
  documents         Document[]
  /// Baux dont la personne est titulaire (seule ou avec d'autres locataires : couple, colocation).
  baux              Bail[]     @relation("BailLocataires")
  attestations      AttestationAssurance[]
  demandes          DemandeMaintenance[]
  /// Espace locataire : jeton d'accès personnel (lien), création, envoi par email et dernière visite.
  accesJeton        String?    @unique
  accesCreeLe       DateTime?
  accesEnvoyeLe     DateTime?
  accesDernierLe    DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([entiteId])
}

enum CategorieDocument {
  PIECE_IDENTITE
  AVIS_IMPOSITION
  LETTRE_RECOMMANDATION
  JUSTIFICATIF_DOMICILE
  JUSTIFICATIF_REVENUS
  AUTRE
}

/// Pièce d'identité ou justificatif importé pour un locataire.
model Document {
  id          Int               @id @default(autoincrement())
  locataireId Int
  locataire   Locataire         @relation(fields: [locataireId], references: [id], onDelete: Cascade)
  categorie   CategorieDocument
  libelle     String?
  nomFichier  String
  chemin      String
  mimeType    String
  taille      Int
  createdAt   DateTime          @default(now())
}

// ---------------------------------------------------------------------------
// Baux
// ---------------------------------------------------------------------------

enum TypeBail {
  NON_MEUBLE
  MEUBLE
  MOBILITE
  COMMERCIAL
  PROFESSIONNEL
  SAISONNIER
}

enum StatutBail {
  BROUILLON
  EN_SIGNATURE
  SIGNE
  TERMINE
}

/// Bail : lien entre un lot et un ou plusieurs locataires (titulaires solidaires : couple, colocation).
model Bail {
  id                 Int              @id @default(autoincrement())
  entiteId           Int
  entite             Entite           @relation(fields: [entiteId], references: [id], onDelete: Restrict)
  lotId              Int
  lot                Lot              @relation(fields: [lotId], references: [id], onDelete: Restrict)
  locataires         Locataire[]      @relation("BailLocataires")
  type               TypeBail
  statut             StatutBail       @default(BROUILLON)
  dateDebut          DateTime
  dateFin            DateTime
  loyerHC            Float
  charges            Float            @default(0)
  chargesForfait     Boolean          @default(false)
  /// Taux de TVA appliqué au loyer et aux charges (0 = exonéré ; 10 ou 20).
  tauxTva            Float            @default(0)
  depotGarantie      Float            @default(0)
  jourEcheance       Int              @default(1)
  motifMobilite      String?
  clauseRevision     Boolean          @default(true)
  irlTrimestre       String?
  irlValeur          Float?
  texteContrat       String?
  signatureRef       String?
  dateSignature      DateTime?
  dateFinEffective   DateTime?
  /// Dépôt de garantie : encaissement, restitution et retenues justifiées (état des lieux de sortie).
  depotRecuLe          DateTime?
  depotRecuMontant     Float?
  depotRecuMode        ModePaiement?
  depotRecuReference   String?
  depotRestitueLe      DateTime?
  depotRestitueMontant Float?
  depotRestitueMode    ModePaiement?
  retenuesDepot        RetenueDepot[]
  /// Sortie du locataire : réception du congé, préavis, départ annoncé et état des lieux de sortie.
  congeRecuLe          DateTime?
  congeOrigine         OrigineConge?
  congeMotif           String?
  congePreavisMois     Int?
  congeDateDepart      DateTime?
  etatLieuxSortieLe    DateTime?
  etatLieuxConforme    Boolean?
  /// Assurance habitation du locataire : attestations reçues et suivi des demandes de renouvellement.
  assurances           AttestationAssurance[]
  assuranceDemandeeLe  DateTime?
  assuranceRelanceLe   DateTime?
  demandes             DemandeMaintenance[]
  /// Exemplaire signé du contrat (PDF ou image déposé par le gestionnaire), consultable dans l'espace locataire.
  contratSigneChemin String?
  contratSigneNom    String?
  contratSigneMime   String?
  contratSigneTaille Int?
  contratSigneLe     DateTime?
  notes              String?
  appels             AppelLoyer[]
  revisions          RevisionLoyer[]
  courriers          Courrier[]
  documents          DocumentGenere[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([entiteId])
}

/// Révision annuelle du loyer sur l'indice de référence des loyers (IRL).
model RevisionLoyer {
  id                  Int      @id @default(autoincrement())
  bailId              Int
  bail                Bail     @relation(fields: [bailId], references: [id], onDelete: Cascade)
  dateEffet           DateTime
  ancienLoyer         Float
  nouveauLoyer        Float
  irlAncienTrimestre  String?
  irlAncienValeur     Float
  irlNouveauTrimestre String?
  irlNouveauValeur    Float
  createdAt           DateTime @default(now())
}

enum TypeCourrier {
  REVISION_LOYER
  RELANCE
  AUTRE
}

/// Courrier adressé au locataire (révision de loyer, relance…), rédigé à la main ou avec l'IA.
model Courrier {
  id        Int          @id @default(autoincrement())
  bailId    Int
  bail      Bail         @relation(fields: [bailId], references: [id], onDelete: Cascade)
  type      TypeCourrier @default(AUTRE)
  objet     String
  contenu   String
  dateEnvoi DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

// ---------------------------------------------------------------------------
// Loyers
// ---------------------------------------------------------------------------

/// Appel de loyer (avis d'échéance) pour une période mensuelle.
model AppelLoyer {
  id                 Int        @id @default(autoincrement())
  bailId             Int
  bail               Bail       @relation(fields: [bailId], references: [id], onDelete: Cascade)
  periode            String
  debutPeriode       DateTime
  finPeriode         DateTime
  dateEmission       DateTime
  dateEcheance       DateTime
  loyer              Float
  charges            Float
  total              Float
  /// TVA de l'appel : taux appliqué et montant ; `total` est toutes taxes comprises.
  tauxTva            Float      @default(0)
  montantTva         Float      @default(0)
  prorata            Boolean    @default(false)
  dateEnvoiAvis      DateTime?
  dateEnvoiQuittance DateTime?
  paiements          Paiement[]
  createdAt          DateTime   @default(now())

  @@unique([bailId, periode])
}

enum ModePaiement {
  VIREMENT
  PRELEVEMENT
  CHEQUE
  ESPECES
  AUTRE
}

model Paiement {
  id        Int          @id @default(autoincrement())
  appelId   Int
  appel     AppelLoyer   @relation(fields: [appelId], references: [id], onDelete: Cascade)
  date      DateTime
  montant   Float
  mode      ModePaiement @default(VIREMENT)
  reference String?
  createdAt DateTime     @default(now())
}

/// Qui a donné congé : le locataire (préavis) ou le bailleur (congé pour vente, reprise ou motif légitime).
enum OrigineConge {
  LOCATAIRE
  BAILLEUR
}

/// Retenue sur le dépôt de garantie, justifiée par l'état des lieux de sortie ou une dette locative.
model RetenueDepot {
  id        Int      @id @default(autoincrement())
  bailId    Int
  bail      Bail     @relation(fields: [bailId], references: [id], onDelete: Cascade)
  libelle   String
  montant   Float
  createdAt DateTime @default(now())

  @@index([bailId])
}

/// Attestation d'assurance habitation remise par le locataire (obligation annuelle, art. 7 g de la loi du 6 juillet 1989).
model AttestationAssurance {
  id                 Int        @id @default(autoincrement())
  bailId             Int
  bail               Bail       @relation(fields: [bailId], references: [id], onDelete: Cascade)
  locataireId        Int?
  locataire          Locataire? @relation(fields: [locataireId], references: [id], onDelete: SetNull)
  compagnie          String?
  numeroPolice       String?
  dateDebut          DateTime?
  dateEcheance       DateTime
  nomFichier         String?
  chemin             String?
  mimeType           String?
  taille             Int?
  /// Déposée par le locataire depuis son espace (sinon saisie par le gestionnaire).
  deposeParLocataire Boolean    @default(false)
  createdAt          DateTime   @default(now())

  @@index([bailId])
}

enum CategorieMaintenance {
  PLOMBERIE
  ELECTRICITE
  CHAUFFAGE
  SERRURERIE
  MENUISERIE
  ELECTROMENAGER
  DEGAT_EAUX
  NUISIBLES
  PARTIES_COMMUNES
  AUTRE
}

enum UrgenceMaintenance {
  NORMALE
  URGENTE
  TRES_URGENTE
}

enum StatutMaintenance {
  NOUVELLE
  PRISE_EN_COMPTE
  PLANIFIEE
  RESOLUE
  REFUSEE
}

enum AuteurMessage {
  LOCATAIRE
  GESTIONNAIRE
}

/// Demande de maintenance (intervention) adressée par le locataire depuis son espace, suivie par le gestionnaire.
model DemandeMaintenance {
  id             Int                  @id @default(autoincrement())
  entiteId       Int
  entite         Entite               @relation(fields: [entiteId], references: [id], onDelete: Restrict)
  bailId         Int
  bail           Bail                 @relation(fields: [bailId], references: [id], onDelete: Cascade)
  lotId          Int
  lot            Lot                  @relation(fields: [lotId], references: [id], onDelete: Restrict)
  locataireId    Int?
  locataire      Locataire?           @relation(fields: [locataireId], references: [id], onDelete: SetNull)
  objet          String
  description    String
  categorie      CategorieMaintenance @default(AUTRE)
  urgence        UrgenceMaintenance   @default(NORMALE)
  statut         StatutMaintenance    @default(NOUVELLE)
  interventionLe DateTime?
  clotureeLe     DateTime?
  /// Dernière lecture par le locataire : repère les réponses non lues dans son espace.
  luLocataireLe  DateTime?
  messages       MessageMaintenance[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([entiteId])
  @@index([bailId])
}

/// Échange lié à une demande de maintenance (locataire ou gestionnaire), avec photo ou devis éventuel.
model MessageMaintenance {
  id         Int                @id @default(autoincrement())
  demandeId  Int
  demande    DemandeMaintenance @relation(fields: [demandeId], references: [id], onDelete: Cascade)
  auteur     AuteurMessage
  texte      String
  nomFichier String?
  chemin     String?
  mimeType   String?
  taille     Int?
  createdAt  DateTime           @default(now())

  @@index([demandeId])
}

// ---------------------------------------------------------------------------
// Dépenses et emprunts
// ---------------------------------------------------------------------------

enum CategorieDepense {
  REPARATION_ENTRETIEN
  AMELIORATION
  GESTION_LOCATIVE
  COPROPRIETE
  ASSURANCE_PNO
  TAXE_FONCIERE
  INTERETS_EMPRUNT
  AUTRE
}

/// Dépense affectée à un lot ou à un immeuble.
model Depense {
  id                 Int              @id @default(autoincrement())
  entiteId           Int
  entite             Entite           @relation(fields: [entiteId], references: [id], onDelete: Restrict)
  date               DateTime
  libelle            String
  categorie          CategorieDepense
  montant            Float
  fournisseur        String?
  notes              String?
  lotId              Int?
  lot                Lot?             @relation(fields: [lotId], references: [id], onDelete: Restrict)
  immeubleId         Int?
  immeuble           Immeuble?        @relation(fields: [immeubleId], references: [id], onDelete: Restrict)
  justificatifNom    String?
  justificatifChemin String?
  justificatifMime   String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([entiteId])
}

/// Emprunt immobilier rattaché à un lot ou à un immeuble.
model Emprunt {
  id                 Int               @id @default(autoincrement())
  entiteId           Int
  entite             Entite            @relation(fields: [entiteId], references: [id], onDelete: Restrict)
  libelle            String
  banque             String?
  reference          String?
  montantInitial     Float
  tauxAnnuel         Float?
  dureeMois          Int?
  dateDebut          DateTime?
  assuranceMensuelle Float?
  notes              String?
  lotId              Int?
  lot                Lot?              @relation(fields: [lotId], references: [id], onDelete: Restrict)
  immeubleId         Int?
  immeuble           Immeuble?         @relation(fields: [immeubleId], references: [id], onDelete: Restrict)
  echeances          EcheanceEmprunt[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([entiteId])
}

/// Ligne d'échéancier : part de capital, d'intérêts et d'assurance.
model EcheanceEmprunt {
  id             Int      @id @default(autoincrement())
  empruntId      Int
  emprunt        Emprunt  @relation(fields: [empruntId], references: [id], onDelete: Cascade)
  date           DateTime
  capital        Float
  interets       Float
  assurance      Float    @default(0)
  total          Float
  capitalRestant Float?

  @@index([empruntId, date])
}

// ---------------------------------------------------------------------------
// Indices INSEE (IRL, ILC, ILAT, ICC, BT01…) : référentiel des séries et historique des valeurs
// ---------------------------------------------------------------------------

/// Fréquence de publication d'une série : mensuelle, trimestrielle ou annuelle.
enum FrequenceSerie {
  M
  Q
  A
}

/// Série de la Banque de données macroéconomiques (BDM) de l'INSEE suivie par l'application.
/// Référentiel vivant en base : une série s'ajoute ou se remplace (rebasage) sans redéploiement ;
/// une seule série active par code, l'ancienne restant inactive avec son historique.
model IndiceSerie {
  id                Int                 @id @default(autoincrement())
  code              String
  idbank            String              @unique
  libelle           String
  libelleInsee      String?
  frequence         FrequenceSerie
  unite             String?
  base              String?
  active            Boolean             @default(true)
  derniereSync      DateTime?
  dernierePeriode   String?
  echecsConsecutifs Int                 @default(0)
  dernierEchec      String?
  observations      IndiceObservation[]
  revisions         IndiceRevision[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([code, active])
}

/// Valeur publiée d'une série pour une période (« 2026-06 », « 2026-Q2 » ou « 2026 »).
/// La valeur est conservée en numérique exact (jamais en flottant).
model IndiceObservation {
  id           Int         @id @default(autoincrement())
  serieId      Int
  serie        IndiceSerie @relation(fields: [serieId], references: [id], onDelete: Cascade)
  periode      String
  debutPeriode DateTime
  valeur       Decimal     @db.Decimal(18, 6)
  statut       String?
  publieLe     DateTime?
  recupereLe   DateTime    @default(now())

  @@unique([serieId, periode])
  @@index([serieId, debutPeriode])
}

/// Révision d'une valeur déjà enregistrée (valeur provisoire devenue définitive, correction de l'INSEE).
model IndiceRevision {
  id             Int         @id @default(autoincrement())
  serieId        Int
  serie          IndiceSerie @relation(fields: [serieId], references: [id], onDelete: Cascade)
  periode        String
  ancienneValeur Decimal     @db.Decimal(18, 6)
  nouvelleValeur Decimal     @db.Decimal(18, 6)
  ancienStatut   String?
  nouveauStatut  String?
  createdAt      DateTime    @default(now())

  @@index([serieId, createdAt])
}

/// Journal d'exécution d'une synchronisation (cron quotidien, lancement manuel ou première utilisation).
model IndiceSynchronisation {
  id                     Int       @id @default(autoincrement())
  declencheur            String
  debut                  DateTime  @default(now())
  fin                    DateTime?
  seriesInterrogees      Int       @default(0)
  observationsCreees     Int       @default(0)
  observationsMisesAJour Int       @default(0)
  erreurs                String?
  alertes                String?
}
